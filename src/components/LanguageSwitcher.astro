---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { stripBase, stripLocale } from "@/utils/withBase";
import {
  getPostLocale,
  getPostSlugPath,
  getPostUrl,
} from "@/utils/getPostPaths";
import { getUniqueTags } from "@/utils/getUniqueTags";
import { filterPostsByLocale } from "@/utils/postsByLocale";
import { LOCALES, LOCALE_NAMES } from "@/i18n/locales";
import { useTranslations } from "@/i18n";
import config from "@/config";

// Link to the same page in another language.
// Articles are matched through `translationOf`, which keeps the slug of the
// Spanish original. Pages that exist in every language keep the same path. When
// a translation is missing the reader lands on that language's home page, so a
// link never leads to a missing page.
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const relative = stripBase(Astro.url.pathname);
const trimmed =
  relative !== "/" && relative.endsWith("/") ? relative.slice(0, -1) : relative;
const path = stripLocale(trimmed, locale).replace(/^\/+|\/+$/g, "");

const posts = await getCollection("posts", ({ data }) => !data.draft);

const current = posts.find(
  post =>
    getPostLocale(post.filePath, post.id) === locale &&
    getPostSlugPath(post.id, post.filePath) === path
);

// Slug of the Spanish original, used to match every translation of an article.
const canonical = current
  ? locale === "es"
    ? path
    : (current.data.translationOf ?? null)
  : null;

function articleUrl(targetLocale: string): string | null {
  if (!current) return null;
  if (getPostLocale(current.filePath, current.id) === targetLocale) {
    return getPostUrl(current.id, current.filePath, targetLocale);
  }
  if (!canonical) return null;

  const twin = posts.find(post => {
    if (getPostLocale(post.filePath, post.id) !== targetLocale) return false;
    return targetLocale === "es"
      ? getPostSlugPath(post.id, post.filePath) === canonical
      : post.data.translationOf === canonical;
  });

  return twin ? getPostUrl(twin.id, twin.filePath, targetLocale) : null;
}

function pageUrl(targetLocale: string): string {
  const [root, second] = path.split("/");

  if (root === "tags" && second) {
    // a tag page only exists in the other language when that language uses it
    const targetTags = getUniqueTags(filterPostsByLocale(posts, targetLocale));
    return targetTags.some(tag => tag.tag === second)
      ? getRelativeLocaleUrl(targetLocale, path)
      : getRelativeLocaleUrl(targetLocale, "tags");
  }

  if (root === "posts" && /^\d+$/.test(second ?? "")) {
    // page 2 of the listing may not exist in the other language
    return getRelativeLocaleUrl(targetLocale, "posts");
  }

  return getRelativeLocaleUrl(targetLocale, path);
}

// On an article list only the languages that actually have it; on any other
// page list every locale the site publishes.
const options = current
  ? LOCALES.filter(targetLocale => articleUrl(targetLocale) !== null)
  : [...LOCALES];
---

{
  options.length > 1 && (
    <li class="relative col-span-1 flex items-center justify-center">
      <details class="group relative">
        <summary
          class="focus-outline hover:text-accent cursor-pointer list-none px-2 py-1 text-sm font-semibold uppercase"
          title={t.a11y.switchLanguage}
          aria-label={t.a11y.switchLanguage}
        >
          {locale}
        </summary>
        <ul class="border-border bg-background absolute end-0 z-50 mt-2 max-h-80 w-44 overflow-auto rounded-md border p-1 shadow-lg">
          {options.map(targetLocale => (
            <li>
              <a
                href={
                  current
                    ? (articleUrl(targetLocale) ?? "")
                    : pageUrl(targetLocale)
                }
                hreflang={targetLocale}
                lang={targetLocale}
                class:list={[
                  "hover:bg-muted block rounded-sm px-3 py-2 text-sm",
                  { "text-accent font-semibold": targetLocale === locale },
                ]}
              >
                {LOCALE_NAMES[targetLocale]}
              </a>
            </li>
          ))}
        </ul>
      </details>
    </li>
  )
}
